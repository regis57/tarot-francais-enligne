# Copiez ce fichier en ".env" puis adaptez les valeurs a votre installation.
# Le fichier .env n'est jamais publie sur GitHub (voir .gitignore).

# Chemin ABSOLU du dossier du projet sur votre machine hote.
# Synology (dossier partage "docker") : /volume1/docker/tarot
# Linux / macOS                        : /home/votre-utilisateur/tarot
TAROT_DIR=/volume1/docker/tarot

# Port par lequel le jeu sera accessible sur votre reseau local.
TAROT_PORT=3001
